* { font-family: "Segoe UI", "Microsoft YaHei UI"; font-size: 13px; }
QMainWindow, QWidget { background: #eef2f4; color: #27333b; }
QMenuBar { background: #ffffff; padding: 3px; border-bottom: 1px solid #d3dce1; }
QMenuBar::item:selected, QMenu::item:selected { background: #dff5f1; color: #087e70; }
QMenu { background: #ffffff; border: 1px solid #ccd7dc; padding: 5px; }
QMenu::item { padding: 7px 26px 7px 12px; }
QStatusBar { background: #ffffff; color: #6f7c84; border-top: 1px solid #d3dce1; }
#sidebar { background: #ffffff; border: 1px solid #d5dee3; border-radius: 12px; }
#eyebrow { color: #099b89; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
#brand { color: #17252d; font-size: 25px; font-weight: 700; }
#brand span { color: #099b89; }
#subtitle, #muted { color: #71808a; }
#sectionTitle { color: #25323a; font-weight: 700; font-size: 14px; margin-top: 3px; }
#primaryButton { background: #13a995; color: white; border: 0; border-radius: 7px; font-weight: 700; padding: 9px; }
#primaryButton:hover { background: #078d7c; }
#secondaryButton, #themeButton { background: #f6f8f9; color: #40505a; border: 1px solid #ccd7dc; border-radius: 7px; padding: 9px; }
#secondaryButton:hover, #themeButton:hover { border-color: #13a995; color: #087e70; }
#debugToggle { background: transparent; color: #687983; border: 0; text-align: left; padding: 5px 2px; font-weight: 600; }
#debugToggle:hover { color: #087e70; }
#debugPanel { background: #f5f8f9; border: 1px solid #d8e1e5; border-radius: 7px; }
#infoCard { background: #f5f8f9; border: 1px solid #d8e1e5; border-radius: 8px; }
#caption { color: #819099; font-size: 11px; }
#fileName { color: #283740; font-weight: 600; }
#separator { color: #dae2e6; background: #dae2e6; max-height: 1px; border: 0; }
#viewportCard { background: #dfe5e8; border: 1px solid #cbd6db; border-radius: 8px; }
#viewportHeader { background: #ffffff; border-bottom: 1px solid #d5dfe3; }
#viewportTitle { color: #2a3941; font-weight: 600; }
#viewportMeta, #footnote { color: #77868f; font-size: 11px; }
#skinDot { color: #d98769; }
#boneDot { color: #b7ad79; }
#valueLabel { color: #078d7c; font-size: 11px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 4px; border: 1px solid #aab9c0; background: white; }
QCheckBox::indicator:checked { background: #13a995; border-color: #13a995; }
QSlider::groove:horizontal { height: 4px; background: #cdd8dd; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #13a995; border-radius: 2px; }
QSlider::handle:horizontal { background: #087e70; width: 14px; margin: -5px 0; border-radius: 7px; }
QSpinBox { background: white; border: 1px solid #c5d1d7; border-radius: 5px; padding: 4px 6px; color: #394850; }
QToolTip { background: white; color: #27333b; border: 1px solid #becbd1; padding: 4px; }
QProgressBar { background: #d5dfe3; border: 0; border-radius: 3px; height: 6px; }
QProgressBar::chunk { background: #13a995; border-radius: 3px; }
