{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg-release",
      "displayName": "vcpkg x64-windows Release",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "F:/source/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vcpkg-release",
      "configuration": "Release"
    }
  ]
}
